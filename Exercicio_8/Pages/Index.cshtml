@page
@model Exercicio_8.Pages.IndexModel

@{
    ViewData["Title"] = "Home page";
}

<h1>Lista de Produtos</h1>

<table class="table">
    <thead>
    <tr>
        <th>Nome do Produto</th>
        <th>Preço</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Name</td>
            <td>R$ @product.Price.ToString("F2")</td>
        </tr>
    }
    </tbody>
</table>

<p>
    <a asp-page="/About">Sobre Nós</a>
</p>
